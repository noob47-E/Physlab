      },
      "parts": [
        {
          "type": "matrix",
          "answer": [
            [
              "ab11",
              "ab12",
              "ab13"
            ],
            [
              "ab21",
              "ab22",
              "ab23"
            ],
            [
              "ab31",
              "ab32",
              "ab33"
            ]
          ],
          "marks": 1,
          "prompt": "\\(A + B = \\) ___",
          "tolerance": {
            "kind": "absolute",
            "value": 0
          }
        }
      ],
      "picture": {
        "kind": "vectors",
        "items": [
          {
            "name": "a₁",
