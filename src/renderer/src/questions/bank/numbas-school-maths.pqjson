    {
      "id": "numbas-q7864-numbas-a0ca8728",
      "title": "Guitar fret spacing",
      "imported": {
        "format": "numbas",
        "changes": [
          "PhysLab added a picture (Numbas gave none): the distance of each fret from the nut on this 647.7 mm scale, fret number across.",
          "Title shortened from 'Instrument Design 1' for the practice list.",
          "The fret formula is set as maths (the original step read 'x_n=L*(1-0.5^(n/12))')."
        ],
        "contributors": [
          "Clodagh Carroll"
        ],
        "itemUrl": "https://numbas.mathcentre.ac.uk/question/7864/instrument-design-1/"
      },
      "license": {
        "id": "CC BY 4.0",
        "found": "Creative Commons Attribution 4.0 International",
        "holder": "Clodagh Carroll",
        "source": "https://numbas.mathcentre.ac.uk/question/7864/instrument-design-1/"
      },
      "parts": [
        {
          "type": "number",
          "answer": "359.2",
          "marks": 2,
          "prompt": "",
          "tolerance": {
            "kind": "absolute",
            "value": 0.05
          },
          "unit": "none"
        }
      ],
      "picture": {
        "kind": "curves",
        "items": [
          {
            "expr": "647.7 * (1 - 2 ^ (-x / 12))",
            "label": "distance from the nut (mm)",
            "from": "0",
            "to": "24"
          }
        ]
      },
      "statement": "The scale length of a standard Fender Stratocaster is 647.7 mm. At what distance from the nut should the 14th fret be placed if equal temperament is used? Give your answer correct to one decimal place.",
      "steps": {
        "items": [
          {
            "blank": false,
            "head": "With equal temperament, the distance from the nut to fret n (the nut is n = 0) on a scale of length L is",
            "tex": "x_n = L\\left(1 - 2^{-n/12}\\right)"
          },
          {
            "blank": false,
            "head": "Here L = 647.7 mm and n = 14:",
            "tex": "x_{14} = 647.7\\left(1 - 2^{-14/12}\\right)"
          }
        ],
        "level": "worked"
      },
      "tags": [
        "general maths"
      ],
      "variables": []
    },
    {
      "id": "numbas-q7872-numbas-2bbf93ae",
      "title": "Guitar scale length",
      "imported": {
        "format": "numbas",
        "changes": [
          "PhysLab added a picture (Numbas gave none): the fraction of the scale length from the nut to each fret, fret number across (the same for every guitar).",
          "Title shortened from 'Instrument Design 9' for the practice list.",
          "Two variables the question never used (L and n) are left out.",
          "The fret formula is set as maths (the original step read 'x_n=L*(1-0.5^(n/12))')."
        ],
        "contributors": [
          "Clodagh Carroll"
        ],
        "itemUrl": "https://numbas.mathcentre.ac.uk/question/7872/instrument-design-9/"
      },
      "license": {
        "id": "CC BY 4.0",
        "found": "Creative Commons Attribution 4.0 International",
        "holder": "Clodagh Carroll",
        "source": "https://numbas.mathcentre.ac.uk/question/7872/instrument-design-9/"
      },
      "parts": [
        {
          "type": "number",
          "answer": "662.4",
          "marks": 4,
          "prompt": "",
          "tolerance": {
            "kind": "absolute",
            "value": 0.05
          },
          "unit": "none"
        }
      ],
      "picture": {
        "kind": "curves",
        "items": [
          {
            "expr": "1 - 2 ^ (-x / 12)",
            "label": "fraction of the scale length",
            "from": "0",
            "to": "24"
          }
        ]
      },
      "statement": "If the 8th fret is 245.1mm from the nut on a guitar, what is the scale length of the guitar? Give your answer correct to one decimal place.",
      "steps": {
        "items": [
          {
            "blank": false,
            "head": "With equal temperament, the distance from the nut to fret n (the nut is n = 0) on a scale of length L is",
            "tex": "x_n = L\\left(1 - 2^{-n/12}\\right)"
          },
          {
            "blank": false,
            "head": "Here the 8th fret is 245.1 mm from the nut, so",
            "tex": "245.1 = L\\left(1 - 2^{-8/12}\\right)"
          }
        ],
        "level": "worked"
      },
      "tags": [
        "general maths"
      ],
