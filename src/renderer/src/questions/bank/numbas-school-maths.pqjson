      "statement": "$$ A = \\left(\\begin{array}{rrr} {a11} & {a12} & {a13}\\\\ {a21} & {a22} & {a23}\\\\ {a31} & {a32} & {a33}\\\\ \\end{array}\\right),\\;\\;\\;\\; B= \\left(\\begin{array}{rrr} {b11} & {b12} & {b13}\\\\ {b21} & {b22} & {b23}\\\\ {b31} & {b32} & {b33}\\\\ \\end{array}\\right) $$",
      "steps": {
        "items": [
