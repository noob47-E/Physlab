    {
      "id": "numbas-q94129-numbas-28575551",
      "title": "Matrix multiplication AB",
      "imported": {
        "format": "numbas",
        "changes": [
          "PhysLab added a picture (Numbas gave none): the columns a₁, a₂, a₃ of A as arrows from the same point; the first column of AB is b₁₁a₁ + b₂₁a₂ + b₃₁a₃, which is left for the student to work out.",
          "Marked exactly, as Numbas marks it: a whole-number answer no longer carries a 2 % band that let an answer one out pass as right.",
          "The step 'Please see lecture slides for worked example' (another course's) is replaced by a worked first entry."
        ],
        "contributors": [
          "Heather Driscoll"
        ],
        "itemUrl": "https://numbas.mathcentre.ac.uk/question/94129/matrix-multiplication-ab/"
      },
      "license": {
        "id": "CC BY 4.0",
        "found": "Creative Commons Attribution 4.0 International",
        "holder": "Heather Driscoll",
        "source": "https://numbas.mathcentre.ac.uk/question/94129/matrix-multiplication-ab/"
      },
      "parts": [
        {
          "type": "matrix",
          "answer": [
            [
              "ab11",
              "ab12",
              "ab13"
            ],
            [
              "ab21",
              "ab22",
              "ab23"
            ],
            [
              "ab31",
              "ab32",
              "ab33"
            ]
          ],
          "marks": 1,
          "prompt": "\\(A \\times B = \\) ___",
          "tolerance": {
            "kind": "absolute",
            "value": 0
          }
        }
      ],
      "picture": {
        "kind": "vectors",
        "items": [
          {
            "name": "a₁",
            "v": [
              "a11",
              "a21",
              "a31"
            ]
          },
          {
            "name": "a₂",
            "v": [
              "a12",
              "a22",
              "a32"
            ]
          },
          {
            "name": "a₃",
            "v": [
              "a13",
              "a23",
              "a33"
            ]
          }
        ]
      },
      "statement": "$$ A = \\left(\\begin{array}{rrr} {a11} & {a12} & {a13}\\\\ {a21} & {a22} & {a23}\\\\ {a31} & {a32} & {a33}\\\\ \\end{array}\\right),\\;\\;\\;\\; B= \\left(\\begin{array}{rrr} {b11} & {b12} & {b13}\\\\ {b21} & {b22} & {b23}\\\\ {b31} & {b32} & {b33}\\\\ \\end{array}\\right) $$",
      "steps": {
        "items": [
          {
            "blank": false,
            "head": "Row i, column j of AB is row i of A times column j of B: multiply the entries in turn and add. The first one:",
            "tex": "(AB)_{11} = {a11} \\times {b11} + {a12} \\times {b21} + {a13} \\times {b31} = {ab11}"
          }
        ],
        "level": "worked"
      },
      "tags": [
        "matrices and linear algebra",
        "number and arithmetic"
      ],
