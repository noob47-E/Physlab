    {
      "id": "numbas-q10367-numbas-0b21f16f",
      "title": "Simple interest",
      "imported": {
        "format": "numbas",
        "changes": [
          "PhysLab added a picture (Numbas gave none): the money in the account year by year, years across: simple interest adds the same amount every year, so it is a straight line.",
          "Title shortened from 'Simple Interest easy' for the practice list.",
          "The answer, asked to 2 decimal places, is marked to the nearest cent rather than to within 2 cents.",
          "A variable the question never used (answer2) is left out.",
          "'&euro;' shown as text is now the euro sign €.",
          "The worked steps are rewritten with their formulas set as maths (the original $…$ maths and &euro; showed as raw text)."
        ],
        "contributors": [
          "Julie Crowley"
        ],
        "itemUrl": "https://numbas.mathcentre.ac.uk/question/10367/simple-interest-easy/"
      },
      "license": {
        "id": "CC BY 4.0",
        "found": "Creative Commons Attribution 4.0 International",
        "holder": "Julie Crowley",
        "source": "https://numbas.mathcentre.ac.uk/question/10367/simple-interest-easy/"
      },
      "parts": [
        {
          "type": "number",
          "answer": "answer1",
          "marks": 2,
          "prompt": "",
          "tolerance": {
            "kind": "absolute",
            "value": 0.005
          },
          "unit": "none"
        }
      ],
      "picture": {
        "kind": "curves",
        "items": [
          {
            "expr": "initial * (1 + x * p / 100)",
            "label": "money in the account (€)",
            "from": "0",
            "to": "10"
          }
        ]
      },
      "statement": "An investor puts €\\({initial}\\) in a savings account that pays \\({p}\\%\\) simple interest at the end of each year. How much would the investor have after \\({n}\\) years?\nGive your answer to \\(2\\) decimal places.",
      "steps": {
        "items": [
          {
            "blank": false,
            "head": "Simple interest each year is the same fraction of the sum put in, so over t years at a rate r:",
            "tex": "I = P \\times t \\times r"
          },
          {
            "blank": false,
            "head": "Here the sum is €{initial}, for {n} years at {p}% a year:",
            "tex": "I = {initial} \\times {n} \\times \\frac{{p}}{100} = {interest}"
          },
          {
            "blank": false,
            "head": "Add the interest to the sum put in to get what the investor has, in euros:",
            "tex": "{initial} + {interest} = {answer1}"
          }
        ],
        "level": "worked"
      },
      "tags": [
        "number and arithmetic"
      ],
      "variables": [
        {
          "name": "nnn",
          "def": {
            "kind": "range",
            "from": 1,
            "step": 1,
            "to": 5
          }
        },
        {
          "name": "nn",
          "def": {
            "kind": "range",
            "from": 1,
            "step": 1,
            "to": 4
          }
        },
        {
          "name": "initial",
          "def": {
            "kind": "range",
            "from": 2000,
            "step": 100,
            "to": 10000
          }
        },
        {
          "name": "answer1",
          "def": {
            "kind": "expr",
            "expr": "initial * (1 + n * p / 100)"
          }
        },
        {
          "name": "n",
          "def": {
            "kind": "expr",
            "expr": "nnn + nn"
          }
        },
        {
          "name": "p",
          "def": {
            "kind": "range",
            "from": 5,
            "step": 1,
            "to": 15
          }
        },
        {
          "name": "interest",
          "def": {
            "kind": "expr",
            "expr": "n * p * initial / 100"
          }
        }
      ]
    },
    {
