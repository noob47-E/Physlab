      },
      "parts": [
        {
          "type": "matrix",
          "answer": [
            [
              "ab11",
              "ab12",
              "ab13"
            ],
            [
              "ab21",
              "ab22",
              "ab23"
            ],
            [
              "ab31",
              "ab32",
              "ab33"
            ]
          ],
          "marks": 1,
          "prompt": "\\(A - B = \\) ___",
          "tolerance": {
            "kind": "absolute",
            "value": 0
          }
        }
      ],
      "picture": {
        "kind": "vectors",
        "items": [
          {
            "name": "a₁",
            "v": [
              "a11",
              "a21",
              "a31"
            ]
          },
          {
            "name": "b₁",
            "v": [
              "b11",
              "b21",
              "b31"
            ]
          }
        ]
      },
      "statement": "$$ A = \\left(\\begin{array}{rrr} {a11} & {a12} & {a13}\\\\ {a21} & {a22} & {a23}\\\\ {a31} & {a32} & {a33}\\\\ \\end{array}\\right),\\;\\;\\;\\; B= \\left(\\begin{array}{rrr} {b11} & {b12} & {b13}\\\\ {b21} & {b22} & {b23}\\\\ {b31} & {b32} & {b33}\\\\ \\end{array}\\right) $$",
      "steps": {
        "items": [
          {
            "blank": false,
            "head": "Subtract the entries in the same place: row i, column j of A − B is the entry there in A minus the entry there in B. The first one:",
            "tex": "(A-B)_{11} = {a11} - {b11} = {ab11}"
          }
        ],
        "level": "worked"
      },
      "tags": [
        "matrices and linear algebra"
      ],
      "variables": [
        {
          "name": "a11",
          "def": {
            "kind": "range",
            "from": -9,
            "step": 1,
            "to": 9
          }
