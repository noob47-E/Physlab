    {
      "id": "numbas-q150096-numbas-e426b71a",
      "title": "VAT on a price",
      "imported": {
        "format": "numbas",
        "changes": [
          "PhysLab added a picture (Numbas gave none): the price with VAT against the price without it, a straight line since VAT is always the same fraction.",
          "Title shortened from 'Calculate VAT question (Newcastle)' for the practice list.",
          "The price with VAT is marked to within 0.0001 and the price without VAT exactly (Numbas marks both exactly); neither carries a 2 % band that would let an answer one out pass as right.",
          "The Numbas editor's label ('Newcastle editor version 1.0', and 'Newcastle' before the first price) is left out, the second price gains its £, and worked steps are added."
        ],
        "contributors": [
          "Ferenc Lengyel"
        ],
        "itemUrl": "https://numbas.mathcentre.ac.uk/question/150096/calculate-vat-question-newcastle/"
      },
      "license": {
        "id": "CC BY 4.0",
        "found": "Creative Commons Attribution 4.0 International",
        "holder": "Ferenc Lengyel",
        "source": "https://numbas.mathcentre.ac.uk/question/150096/calculate-vat-question-newcastle/"
      },
      "parts": [
        {
          "type": "number",
          "answer": "vatprice1",
          "marks": 1,
          "prompt": "The price of the 1st product without VAT is £{novatprice1}. VAT is 20%. What is its full price, in pounds? ___",
          "tolerance": {
            "kind": "absolute",
            "value": 0.0001
          },
          "unit": "none"
        },
        {
          "type": "number",
          "answer": "novatprice2",
          "marks": 1,
          "prompt": "The 2nd product's full price, with VAT, is £{vatprice2}. What is its price without VAT, in pounds? ___",
          "tolerance": {
            "kind": "absolute",
            "value": 0
          },
          "unit": "none"
        }
      ],
      "picture": {
        "kind": "curves",
        "items": [
          {
            "expr": "6 / 5 * x",
            "label": "price with 20% VAT (£)",
            "from": "0",
            "to": "100"
          }
        ]
      },
      "statement": "We are going to work out the price of different products with and without VAT (20%).",
      "tags": [
        "number and arithmetic"
      ],
      "variables": [
        {
          "name": "novatprice1",
          "def": {
            "kind": "range",
            "from": 10,
            "step": 10,
            "to": 100
          },
          "description": "price without VAT"
        },
        {
          "name": "vatprice1",
          "def": {
            "kind": "expr",
            "expr": "novatprice1 * 6 / 5"
          },
          "description": "price with 20 % VAT"
        },
        {
          "name": "novatprice2",
          "def": {
            "kind": "range",
            "from": 10,
            "step": 10,
            "to": 100
          }
        },
        {
          "name": "vatprice2",
          "def": {
            "kind": "expr",
            "expr": "novatprice2 * 6 / 5"
          }
        }
      ],
      "steps": {
        "level": "worked",
        "items": [
          {
            "blank": false,
            "head": "20% VAT adds a fifth of the price, so the full price is 1.2 times the price without VAT:",
            "tex": "{novatprice1} \\times 1.2 = {vatprice1}"
          },
          {
            "blank": false,
            "head": "Going back, divide the full price by 1.2:",
            "tex": "{vatprice2} \\div 1.2 = {novatprice2}"
          }
        ]
      }
