    {
      "id": "numbas-q34513-numbas-7e3c7f64",
      "title": "Adding two measured lengths",
      "imported": {
        "format": "numbas",
        "changes": [
          "PhysLab added a picture (Numbas gave none): the two layers as bars, thickness across.",
          "Title shortened from 'Addition:  2 numbers' for the practice list.",
          "'Caclulate' is spelt 'Calculate'; the answer is the total to 2 significant figures, marked to within 0.0001, where the original accepted anything within 5 % of the unrounded sum."
        ],
        "contributors": [
          "Christopher Saville"
        ],
        "itemUrl": "https://numbas.mathcentre.ac.uk/question/34513/addition-2-numbers/"
      },
      "license": {
        "id": "CC BY 4.0",
        "found": "Creative Commons Attribution 4.0 International",
        "holder": "Christopher Saville",
        "source": "https://numbas.mathcentre.ac.uk/question/34513/addition-2-numbers/"
      },
      "parts": [
        {
          "type": "number",
          "answer": "total",
          "marks": 2,
          "prompt": "One layer is {a} m thick. The other layer is {b} m thick, so the total is \\({a} + {b}\\) metres. ___",
          "tolerance": {
            "kind": "absolute",
            "value": 0.0001
          },
          "unit": "none"
        }
      ],
      "picture": {
        "kind": "curves",
        "items": [
          {
            "expr": "2",
            "label": "layer 1: {a} m",
            "from": "0",
            "to": "a"
          },
          {
            "expr": "1",
            "label": "layer 2: {b} m",
            "from": "0",
            "to": "b"
          }
        ]
      },
      "statement": "The thickness of two sedimentary layers is measured. Calculate the total thickness. Give your answer to 2 significant figures.",
      "steps": {
        "items": [
          {
            "blank": false,
            "head": "Add the two thicknesses, then round to 2 significant figures: keep the first two digits that are not zeros, rounding up when the next digit is 5 or more."
          }
        ],
        "level": "worked"
      },
      "tags": [
        "general maths"
      ],
      "variables": [
        {
          "name": "a",
          "def": {
            "kind": "range",
            "from": 0.01,
            "step": 0.01,
            "to": 10
          },
          "description": "Thickness of layer 1. The thickness is assumed to be constant."
        },
        {
          "name": "b",
          "def": {
            "kind": "range",
            "from": 0.01,
            "step": 0.01,
            "to": 10
          },
          "description": "Thickness of layer 2. The thickness is assumed to be constant."
        },
        {
          "name": "total",
          "def": {
            "kind": "expr",
            "expr": "round(a + b, max(0, 1 - floor(log10(a + b))))"
          },
          "description": "The total thickness to 2 significant figures."
        }
      ]
    },
    {
      "id": "numbas-q40319-numbas-8128225f",
      "title": "Find the missing quantity",
      "condition": {
        "maxRuns": 100,
        "when": "a != b and a != 2 * b"
      },
      "imported": {
        "format": "numbas",
        "changes": [
          "PhysLab added a picture (Numbas gave none): the cost against the number of stems, a straight line through 0 since the price is the same per stem.",
          "Title shortened from 'Don's copy of 3.4 Find the missing quantity Q3 (different variable coding)' for the practice list.",
          "A worked step is added.",
          "The prices are written in dollars in words ('40 dollars'), not with a $ sign."
        ],
        "contributors": [
          "TEAME CIT",
          "Don Shearman",
          "Susan McGlynn"
        ],
        "itemUrl": "https://numbas.mathcentre.ac.uk/question/40319/don-s-copy-of-3-4-find-the-missing-quantity-q3-dif/"
      },
      "license": {
        "id": "CC BY 4.0",
        "found": "Creative Commons Attribution 4.0 International",
        "holder": "TEAME CIT, Don Shearman, Susan McGlynn",
        "source": "https://numbas.mathcentre.ac.uk/question/40319/don-s-copy-of-3-4-find-the-missing-quantity-q3-dif/"
      },
      "parts": [
        {
          "type": "number",
          "answer": "c * f / d",
          "marks": 1,
          "prompt": "Suppose \\({d}\\) flower stems cost \\({f}\\) dollars. How much would you pay for \\({c}\\) flower stems? Cost = ___ dollars",
          "tolerance": {
            "kind": "absolute",
            "value": 0.005
          },
          "unit": "none"
        }
      ],
      "picture": {
        "kind": "curves",
        "items": [
          {
            "expr": "f / d * x",
            "label": "cost in dollars of x stems",
            "from": "0",
            "to": "max(c, d)"
          }
        ]
      },
      "statement": "",
      "tags": [
        "general maths"
      ],
      "variables": [
        {
          "name": "a",
          "def": {
            "kind": "list",
            "items": [
              2,
              3,
              4
            ]
          }
        },
        {
          "name": "b",
          "def": {
            "kind": "list",
            "items": [
              2,
              5,
              7
            ]
          }
        },
        {
          "name": "k",
          "def": {
            "kind": "list",
            "items": [
              5,
              7,
              8
            ]
          }
        },
        {
          "name": "c",
          "def": {
            "kind": "expr",
            "expr": "a * k"
          }
        },
        {
          "name": "d",
          "def": {
            "kind": "expr",
            "expr": "b * k"
          },
          "description": "d"
        },
        {
          "name": "f",
          "def": {
            "kind": "list",
            "items": [
              20,
              30,
              40
            ]
          }
        }
      ],
      "steps": {
        "level": "worked",
        "items": [
          {
            "blank": false,
            "head": "Find the cost of one stem, then multiply by how many you want:",
            "tex": "\\frac{{f}}{{d}} \\times {c}"
          }
        ]
      }
    },
