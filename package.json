{
  "name": "physlab",
  "productName": "PhysLab",
  "version": "0.3.10",
  "description": "Personal physics and math simulation engine",
  "main": "./out/main/index.js",
  "author": "PhysLab",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.physlab.desktop",
    "productName": "PhysLab",
    "copyright": " ",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PhysLab",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dockview-react": "^8.3.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "immer": "^11.1.18",
    "jolt-physics": "^1.1.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.46.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "pyodide": "^314.0.7",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "uplot": "^1.6.32",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
